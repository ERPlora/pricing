{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pricing.rules.calculate_discount payload",
  "type": "object",
  "properties": {
    "amount": { "type": ["string", "number"] },
    "rules": {
      "type": ["array", "null"],
      "description": "null = cargar todas las reglas activas; lista de UUID-strings = solo esas (activas); lista de dicts = reglas inline (preview, sin lookup en BD).",
      "items": {
        "type": ["string", "object"]
      },
      "default": null
    },
    "customer_segment": {
      "type": ["string", "null"],
      "enum": ["customer", "business", "wholesale", "retail", null],
      "default": null
    }
  },
  "required": ["amount"],
  "additionalProperties": false
}
