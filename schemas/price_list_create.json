{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pricing.price_lists.create payload",
  "type": "object",
  "properties": {
    "code": { "type": "string", "minLength": 1, "maxLength": 50 },
    "name": { "type": "string", "minLength": 1, "maxLength": 200 },
    "currency": { "type": "string", "minLength": 3, "maxLength": 3, "default": "EUR" },
    "segment": {
      "type": ["string", "null"],
      "enum": ["customer", "business", "wholesale", "retail", null],
      "default": null
    },
    "is_default": { "type": "boolean", "default": false },
    "tax_included": {
      "type": ["boolean", "null"],
      "default": null,
      "description": "Do this list's prices already carry the tax? true = gross (retail/POS, art. 88.Uno LIVA) · false = taxable base, tax added on top (B2B) · null = inherit the hub (hub_settings.tax_mode, then inclusive). ADR-0210."
    },
    "valid_from": { "type": ["string", "null"], "format": "date", "default": null },
    "valid_until": { "type": ["string", "null"], "format": "date", "default": null }
  },
  "required": ["code", "name"],
  "additionalProperties": false
}
